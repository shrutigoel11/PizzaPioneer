<!-- listings/about.ejs -->
<% layout('layouts/boilerplate') %>

<!-- Hero Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 text-center">
        <h1 class="display-4 fw-bold mb-4">About Us</h1>
        <p class="lead text-muted">Learn more about who we are, what we do, and why we do it!</p>
        <hr class="my-4 w-25 mx-auto">
      </div>
    </div>
  </div>
</section>

<!-- Mission & Team Section -->
<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <!-- Mission Statement -->
      <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body">
            <h2 class="card-title h3 mb-4 fw-bold">Our Mission</h2>
            <p class="card-text text-muted">
              At PizzaPioneer, we are committed to delivering high-quality, delicious pizzas 
              to our customers. We believe in fresh ingredients, unique recipes, and providing 
              an unforgettable dining experience.
            </p>
          </div>
        </div>
      </div>

      <!-- Team Section -->
      <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body">
            <h2 class="card-title h3 mb-4 fw-bold">Meet Our Team</h2>
            <p class="card-text text-muted mb-4">
              Our team is dedicated to ensuring every customer has a great experience. From our 
              chefs to our customer support, each member of our team plays a crucial role in 
              making your visit memorable.
            </p>
            <ul class="list-unstyled">
              <li class="mb-3 d-flex align-items-center">
                <span class="badge bg-primary rounded-circle p-2 me-2"></span>
                <span class="fw-bold">John Doe:</span>
                <span class="text-muted ms-2">Founder & CEO</span>
              </li>
              <li class="mb-3 d-flex align-items-center">
                <span class="badge bg-primary rounded-circle p-2 me-2"></span>
                <span class="fw-bold">Jane Smith:</span>
                <span class="text-muted ms-2">Head Chef</span>
              </li>
              <li class="mb-3 d-flex align-items-center">
                <span class="badge bg-primary rounded-circle p-2 me-2"></span>
                <span class="fw-bold">Mike Johnson:</span>
                <span class="text-muted ms-2">Marketing Manager</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



   <!-- Quality, Service, Sustainability Cards -->
<div class="row g-4">
    <!-- Quality Card -->
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm text-center">
        <div class="card-body p-4">
          <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto"
               style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-star-fill fs-3"></i>
          </div>
          <h3 class="h4 fw-bold mb-3">Quality</h3>
          <p class="text-muted">
            We only use the freshest ingredients, ensuring the highest quality pizza every time.
          </p>
        </div>
      </div>
    </div>
  
    <!-- Service Card -->
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm text-center">
        <div class="card-body p-4">
          <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto"
               style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-people-fill fs-3"></i>
          </div>
          <h3 class="h4 fw-bold mb-3">Service</h3>
          <p class="text-muted">
            Our team is here to provide you with exceptional service, making sure you feel right at home.
          </p>
        </div>
      </div>
    </div>
  
    <!-- Sustainability Card -->
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm text-center">
        <div class="card-body p-4">
          <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto"
               style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-leaf-fill fs-3"></i>
          </div>
          <h3 class="h4 fw-bold mb-3">Sustainability</h3>
          <p class="text-muted">
            We work to minimize waste, use eco-friendly packaging, and support green initiatives.
          </p>
        </div>
      </div>
    </div>
  </div>
  
</section>

<!-- Location Section -->
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-10">
        <h2 class="h2 fw-bold text-center mb-4">Our Location</h2>
        <div class="ratio ratio-16x9 rounded shadow-sm overflow-hidden">
          <!-- Replace YOUR_GOOGLE_MAP_EMBED_URL with your actual Google Maps embed URL -->
          <iframe src="https://www.google.com/maps/embed?pb=YOUR_GOOGLE_MAP_EMBED_URL" 
                  allowfullscreen="" loading="lazy">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-md-8">
        <h2 class="h2 fw-bold mb-4">Want to know more?</h2>
        <p class="text-muted mb-4">
          If you want to learn more about our story, or if you have any questions, 
          don't hesitate to reach out to us!
        </p>
        <a href="mailto:contact@pizzapioneer.com" 
           class="btn btn-primary btn-lg px-5 py-3 rounded-pill">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Social Links -->
<section class="py-4">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-auto">
        <div class="d-flex gap-4">
          <a href="#" class="text-muted hover-primary fs-4">
            <i class="bi bi-facebook"></i>
          </a>
          <a href="#" class="text-muted hover-primary fs-4">
            <i class="bi bi-instagram"></i>
          </a>
          <a href="#" class="text-muted hover-primary fs-4">
            <i class="bi bi-twitter"></i>
          </a>
          <a href="#" class="text-muted hover-primary fs-4">
            <i class="bi bi-linkedin"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>